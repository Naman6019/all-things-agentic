# --- Gemini / Vertex ---
GOOGLE_CLOUD_PROJECT=your-gcp-project
# MUST be `global`, not a region. The Gemini 3.x models are only served on
# Vertex's global endpoint -- us-central1 returns 404 NOT_FOUND for them
# (verified 2026-08-11; 2.5 is the newest available regionally). This setting is
# the Vertex model endpoint only; the Cloud Run deploy region is CLOUD_RUN_REGION.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# If your ADC has a different quota project (check the quota_project_id in
# application_default_credentials.json), override it per-app here rather than
# changing the global gcloud default:
# GOOGLE_CLOUD_QUOTA_PROJECT=your-gcp-project
#
# If using the direct Gemini API (AI Studio) instead of Vertex, comment the
# lines above and set this instead:
# GOOGLE_API_KEY=your-ai-studio-key
GEMINI_MODEL=gemini-3.6-flash

# The two pipeline stages can run different models, both defaulting to
# GEMINI_MODEL. Evaluation runs once per job and is ~89% of a run's cost;
# drafting runs only once per match and is where quality is visible to a human.
# Run benchmark_evaluators.py before pointing evaluation at a cheaper model --
# a wrong skip hides a real job from you.
EVALUATOR_MODEL=
DRAFTER_MODEL=
# Optional: "low" trades reasoning depth for cost. Thinking tokens bill at the
# output rate and were half of a measured run. Ignored by the -lite tiers,
# which do not think at all.
EVALUATOR_THINKING_LEVEL=

# LangGraph is the default orchestration path (state machine with explicit
# nodes and conditional routing). The linear pipeline.py path remains as a
# fallback if this is set to "false".
USE_LANGGRAPH_PIPELINE=true

# A job skipped by a DIFFERENT model or against a DIFFERENT profile is offered
# up again; matched jobs are never resurfaced. This is what makes trialling a
# cheap evaluator reversible. Cost: editing target_titles or switching
# EVALUATOR_MODEL puts every previously skipped job back in the queue, bounded
# per run by MAX_JOBS_PER_RUN.
REEVALUATE_SKIPS_ON_CHANGE=true

# --- Job sources: company career portals, from startups through large firms ---
# Comma-separated Greenhouse board slugs, e.g. from boards.greenhouse.io/<slug>
GREENHOUSE_BOARD_SLUGS=
# Comma-separated Lever board slugs, e.g. from jobs.lever.co/<slug>
LEVER_BOARD_SLUGS=
# Comma-separated Ashby slugs, e.g. from jobs.ashbyhq.com/<slug>. Most of the
# AI labs are on Ashby rather than Greenhouse.
ASHBY_BOARD_SLUGS=
# Comma-separated SmartRecruiters slugs, e.g. from
# jobs.smartrecruiters.com/<slug>. Note this ATS needs a second request per
# posting for the description, so it is the slowest source per job.
SMARTRECRUITERS_COMPANY_SLUGS=

# Additional employer-owned portals. This is an opt-in JSON array so every
# endpoint is reviewable; no connector logs in or bypasses access controls.
# - Workable: company + public account slug.
# - Workday: external CXS endpoint in url; human careers base in careers_url.
# - oracle/successfactors/icims/taleo/feed: an employer-published RSS/Atom,
#   sitemap, JSON feed, or page containing schema.org JobPosting data.
COMPANY_CAREER_PORTALS_JSON=[]
# Example (keep on one line in a real .env file):
# COMPANY_CAREER_PORTALS_JSON=[{"provider":"workable","company":"Acme","slug":"acme"},{"provider":"workday","company":"Big Co","slug":"bigco","url":"https://bigco.wd5.myworkdayjobs.com/wday/cxs/bigco/External","careers_url":"https://bigco.wd5.myworkdayjobs.com/en-US/External"},{"provider":"oracle","company":"Example MNC","slug":"example-mnc","url":"https://careers.example.com/jobs-sitemap.xml","careers_url":"https://careers.example.com"}]
# Bounds Workday detail hydration and sitemap traversal per configured portal.
COMPANY_PORTAL_MAX_DETAIL_PAGES=25

# Aggregator feeds covering popular job sites without scraping them.
ENABLE_ARBEITNOW=true
ENABLE_REMOTIVE=true
ENABLE_REMOTEOK=true
ENABLE_JOBICY=true

# Board Scout: one grounded search call per explicit /discover-boards run.
BOARD_SCOUT_MODEL=gemini-3.5-flash
BOARD_SCOUT_MAX_CANDIDATES=6
BOARD_REGISTRY_MAX_ACTIVE=24

# Hard cap on unseen jobs handed to the model per run. Relevant jobs are
# selected round-robin across sources so one company or feed cannot monopolize
# a run. Sources are far larger
# than they look: one Greenhouse board can return 500+ postings, and the
# Arbeitnow feed returns ~175 (~1.8M characters) in a single page. Jobs past
# the cap stay unseen and get picked up by a later run.
MAX_JOBS_PER_RUN=5

# Title phrases that put a role above your level. These pass the target-title
# check ("Staff Software Engineer" does contain "software engineer") and are
# then correctly rejected by the model on years of experience -- but only after
# a full evaluation has been paid for. Matched as whole words, so "head of"
# does not fire on "overhead". Drop "senior" from this list if you want senior
# postings back -- some ask for only 3 years and are worth a look.
EXCLUDE_TITLE_KEYWORDS=staff,principal,director,distinguished,fellow,vp,vice president,head of,chief,senior

# --- Contact-finding fallback ---
HUNTER_API_KEY=

# --- Notification ---
# Leave DIGEST_TO_EMAIL blank to print the digest to the console instead of
# sending it -- useful while developing.
DIGEST_TO_EMAIL=
SMTP_USER=
SMTP_PASSWORD=

# --- Tenancy ---
# Owner of every per-user document. Single hardcoded value until there is auth;
# the data model is already scoped so adding real users means wiring an identity
# into this rather than migrating every document.
USER_ID=owner

# --- Storage ---
FIRESTORE_PROJECT=
PROFILE_PATH=profile.json

# --- Deploy ---
# Separate from GOOGLE_CLOUD_LOCATION on purpose: `global` is a valid Vertex
# model endpoint but not a valid Cloud Run region.
CLOUD_RUN_REGION=us-central1

# --- TalentOS // Studio (Freelance Client Pipeline) ---
# Freelance sources: public hiring boards, no scraping, no auto-submit.
ENABLE_RFORHIRE=true
ENABLE_WWR_CONTRACT=true
ENABLE_CONTRA=true
ENABLE_PEERLIST=false
# Hard cap on leads per freelance run (same rationale as MAX_JOBS_PER_RUN).
MAX_LEADS_PER_RUN=10
# Freelance model config (defaults to GEMINI_MODEL).
FREELANCE_EVALUATOR_MODEL=
FREELANCE_PITCHER_MODEL=
