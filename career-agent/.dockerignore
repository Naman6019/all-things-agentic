# Dockerfile does `COPY . .`, so anything not excluded here is baked into the
# image that gets pushed to Artifact Registry. Secrets must never land there --
# use Secret Manager / --set-env-vars instead.
.env
.env.*
!.env.example
profile.json

.venv/
venv/
__pycache__/
*.pyc
.git/
.gitignore

# Test and dev tooling: the runtime image should carry only what serves
# requests. Run the suite locally with requirements-dev.txt.
tests/
pytest.ini
requirements-dev.txt
benchmark_evaluators.py

*.md
!README.md
